# Copy to .env (never commit it) and fill in the values for docker-compose.standalone.yml.

# Token protecting the web UI and /api/*. Use a long random value: openssl rand -hex 32
AUTH_TOKEN=

# The app's own login on the built-in Mosquitto broker (created automatically).
# Use a different value from the device logins. Generate one with: openssl rand -hex 16
MQTT_USER=petlibro
MQTT_PASS=

# Timezone for schedules and logs
TZ=UTC

# Alerts without Home Assistant (optional): an ntfy topic URL or a webhook URL.
# Also settable in the app under Settings > Notifications, which wins over these.
# NOTIFY_PUSH_URL=https://ntfy.sh/your-secret-topic
# ntfy (default) or webhook
# NOTIFY_PUSH_FORMAT=ntfy
# Access token, or user:password
# NOTIFY_PUSH_TOKEN=
